<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the user point a profile/sync folder at a raw path Storage Access Framework's own
         picker refuses to even navigate into (e.g. another app's Android/data, where emulator
         saves live) — confirmed on real hardware that plain java.io.File access to such a path
         works once this is granted, SAF or not. Requested on demand via Settings (see
         AllFilesAccess.android.kt), never at install time — it's a sensitive "special app access"
         permission, not a runtime-prompt one. tools:ignore=ScopedStorage: Play Store restricts
         this to apps that qualify as file managers, but this app is sideloaded, not distributed
         there. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Needed by the bundled rclone binary: cloud sync itself obviously needs network access,
         and even the local OAuth handshake (a loopback listen socket on 127.0.0.1:53682) is
         blocked by SELinux without this — Android only grants the INET socket group to apps that
         declare it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CloudSyncForegroundService: some devices cut ALL network access for backgrounded apps
         with zero grace period (confirmed via dumpsys netpolicy on real hardware) — the Google
         Drive OAuth flow inherently backgrounds this app the moment the browser takes the screen,
         right as rclone needs to exchange the auth code for a token. A foreground service with a
         visible notification is Android's sanctioned way to stay exempt from that. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Runtime-requested on API 33+ (see MainActivity) — without it the notification itself
         won't show, though the foreground-service network exemption still applies. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.multiprofileemu.MultiProfileEmuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiProfileEmu"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MultiProfileEmu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CloudSyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Lets this app talk to a running Shizuku (started separately by the user via Wireless
             debugging or USB pairing) to run shell-privileged commands — specifically, writing a
             synced file back into another app's Android/data folder, which this app's own
             process cannot do even with MANAGE_EXTERNAL_STORAGE (see ShizukuBridge.android.kt).
             Required by shizuku-api regardless of Shizuku's own version. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
